# .env.example
# Copy to .env and fill in real values. Never commit .env.

# ── Django ────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bom.lumelabs.dev
EXTERNAL_API_KEY=replace-with-the-shared-api-secret

# Non-default Django admin path (must end with '/')
DJANGO_ADMIN_URL=django-admin/

# ── Security (production defaults assume DEBUG=False; override only if
#    you know you need to, e.g. testing HTTPS settings locally) ────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ── django-axes (login lockout) ────────────────────────────
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME_HOURS=1

# ── Google sign-in (admins only — see CLAUDE.md Security section) ─────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI: https://bom.lumelabs.dev/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allow-list — only these emails may sign in with Google,
# and only if an admin account with that email already exists.
GOOGLE_ALLOWED_ADMIN_EMAILS=

# ── BOM voice assistant (optional) ───────────────────────
# Any OpenAI-compatible chat-completions provider. Leave the key empty to
# hide the Voice Assistant button. Check your provider's current model
# list — free-tier model names change.
#
# Gemini free tier (default) — key from https://aistudio.google.com/apikey
BOM_ASSISTANT_API_KEY=
BOM_ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BOM_ASSISTANT_MODEL=gemini-2.5-flash
#
# Groq — key from https://console.groq.com/keys
# BOM_ASSISTANT_API_KEY=gsk_...
# BOM_ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
# BOM_ASSISTANT_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────────────────────
# SQLite phase: leave DATABASE_URL blank or omit it entirely.
# PostgreSQL phase: uncomment and fill in.
# DATABASE_URL=postgres://django:password@db:5432/bom_costing

# ── Static files ──────────────────────────────────────────
# Must match STATIC_ROOT in settings.py
STATIC_ROOT=/app/staticfiles

# ── Gunicorn tuning (optional) ────────────────────────────
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# ── PostgreSQL credentials (used by the db service) ───────
# POSTGRES_DB=bom_costing
# POSTGRES_USER=django
# POSTGRES_PASSWORD=replace-with-strong-password